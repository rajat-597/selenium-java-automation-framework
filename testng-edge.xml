<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Edge Parallel Regression Suite"
       parallel="methods"
       thread-count="3">

    <groups>
        <run>
            <include name="regression"/>
        </run>
    </groups>

    <test name="Edge Regression Tests">
        <parameter name="browser" value="edge">
        </parameter>

        <packages>
            <package name="com.rajat.automation.tests.ui"/>
        </packages>
    </test>

</suite>