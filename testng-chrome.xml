<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Chrome Parallel Regression Suite"
       parallel="methods"
       thread-count="3">

    <groups>
        <run>
            <include name="regression"/>
        </run>
    </groups>

    <test name="Chrome Regression Tests">
        <packages>
            <package name="com.rajat.automation.tests.ui"/>
        </packages>
    </test>

</suite>